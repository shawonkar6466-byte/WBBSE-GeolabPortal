rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Diagnostic connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Questions: readable by public/students; writeable by authenticated admins/teachers
    match /questions/{questionId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // Users: authenticated profile management
    match /users/{userId} {
      allow read, write: if true;
    }

    // PDF Answer Sheets: readable by registered students; uploadable by admins
    match /chapter_answer_sheets/{sheetId} {
      allow read: if true;
      allow write: if true;
    }

    // Payments: student submission and admin approval
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Mock Tests: available for practice
    match /mock_tests/{testId} {
      allow read: if true;
      allow write: if true;
    }

    // System Settings: global configurations
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // User Purchases & Bundles: store student access permissions
    match /user_purchases/{purchaseId} {
      allow read, write: if true;
    }

    // Promo Code Requests: student requests and admin approvals
    match /promo_requests/{promoId} {
      allow read, write: if true;
    }

    // Admin Notifications
    match /admin_notifications/{notifId} {
      allow read, write: if true;
    }

    // Student Doubts
    match /student_doubts/{doubtId} {
      allow read, write: if true;
    }

    // Exam Submissions
    match /exam_submissions/{subId} {
      allow read, write: if true;
    }
  }
}

